# What port to run on (defaults to 8050)
PORT=8050

# S3-compatible storage settings
AWS_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY

# Leave both values blank for AWS S3
AWS_REGION=
AWS_ENDPOINT_URL=
S3_BUCKET=YOUR_BUCKET_NAME
S3_KEY=YOUR_OBJECT_KEY.parquet

# development: Dashboard will use local data
# production: Dashboard will get data and write logs to S3-compatible storage
ENV=development
